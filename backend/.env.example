# GeoTerra AI Backend Configuration
# Copy to backend/.env and supply your NVIDIA NIM key if running live inference.
# Never commit backend/.env or expose NVIDIA_API_KEY to the frontend.

NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_VLM_MODEL=microsoft/phi-3.5-vision-instruct
GEOTERRA_DATA_DIR=backend/data
GEOTERRA_CACHE_DIR=backend/cache
GEOTERRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
